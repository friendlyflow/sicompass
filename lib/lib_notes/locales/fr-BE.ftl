# Chaînes du fournisseur de notes — Français (Belgique).

notes-display-name = notes

notes-list-meta = info de liste :

notes-visibility = visibilité
notes-visibility-private = privé
notes-visibility-public = public

notes-sha256 = sha256 : { $hash }

notes-empty = pas encore de notes, appuyez sur ctrl+a pour en écrire une

notes-gone = cette note n'est plus ici

notes-cmd-move-up = déplacer vers le haut
notes-cmd-move-down = déplacer vers le bas
notes-cmd-duplicate = dupliquer

notes-error-meta-undeletable = l'info de liste appartient à la liste et ne peut pas être supprimée
notes-error-meta-readonly = l'info de liste ne peut pas être modifiée, changez la visibilité à l'intérieur
notes-error-unreadable = vos notes n'ont pas pu être lues, rien n'a été enregistré, les fichiers sur le disque sont intacts
notes-error-save = vos notes n'ont pas pu être enregistrées
