# Gemeinsame Texte fuer jeden Anbieter mit Cloud-Sicherung.
#
# Bewusst schlicht: kein Geviertstrich und kein Semikolon, denn ein
# Bildschirmleser liest diese Zeilen vor.

payments-cloud-needs-payment = Cloud-Sicherung: Zahlung nötig, holen Sie Sicompass Cloud
payments-cloud-active = Cloud-Sicherung: aktiv, verlaengert sich in { $days } Tagen
payments-cloud-expired = Cloud-Sicherung: Abonnement vor { $days } Tagen abgelaufen
payments-cloud-grace = Cloud-Sicherung: Abo abgelaufen, noch { $days } Tage aktiv, verlängern Sie, um sie zu behalten
payments-cloud-invalid = Cloud-Sicherung: das Lizenzzertifikat wurde abgelehnt ({ $why })

payments-cloud-needs-subscription = die Cloud-Sicherung braucht Sicompass Cloud, früher Cloud und Geschäft
payments-backup-failed = Cloud-Sicherung fehlgeschlagen: { $reason }

payments-command-restore = Cloud-Sicherung wiederherstellen
payments-restore-done = Cloud-Sicherung wiederhergestellt
payments-restore-empty = es gibt keine Cloud-Sicherung zum Wiederherstellen
payments-restore-refused = der lokale Speicher ist nicht leer, es wurde nichts wiederhergestellt

# What the cloud backup uses, as the server last reported it (shown in the Store).
payments-usage-stored = { $used } von { $cap } in der Cloud gespeichert
payments-usage-transferred = { $used } von { $cap } diesen Monat übertragen
