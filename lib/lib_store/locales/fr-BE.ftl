# Store provider strings, Belgian French.

store-display-name = store
store-programs = programmes
store-loading = Chargement de la liste du store. Appuyez à nouveau sur Gauche puis Droite dans un instant.
store-load-failed = La liste du store n'a pas pu être chargée : { $err }
store-offline = Hors ligne, voici donc la liste du store intégrée à cette version de sicompass.
store-check-again = vérifier à nouveau
store-checking = Recherche de nouvelles versions dans le store.
store-no-programs = Le store ne propose encore aucun programme.
store-state-not-installed = non installé
store-state-installed = installé, version { $version }
store-state-update = installé, version { $version }, version { $new } disponible
store-state-frozen = mises à jour suspendues
store-state-data-waiting = pas installé, vos données sont sur cet ordinateur
store-state-used-before = pas installé, vous l'utilisiez avant
store-data-waiting = Vos données sont sur cet ordinateur, dans { $path }. L'installer rouvre ces données.
store-data-waiting-root = Pas installés, mais vous les utilisiez avant : { $names }. Ils étaient livrés avec sicompass jusqu'à la version 0.2 et s'installent maintenant depuis le store. Installez-les sous programmes pour reprendre là où vous en étiez.
store-release-unavailable = Sa dernière version n'a pas pu être vérifiée : { $err }
store-version = Dernière version : { $version }
store-version-frozen = Version : { $version }
store-category = Catégorie : { $category }
store-state-not-approved = installé, version { $version }, non approuvé
store-not-approved = Ne s'exécute pas : vous n'avez pas encore approuvé cette version.
store-approve = Approuver et démarrer
store-access-program = S'exécute comme un programme sur cet ordinateur, avec vos droits. Ce qui suit est ce qu'il dit faire, et sicompass ne peut pas l'y contraindre.
store-access-none = Accès : rien en dehors du programme lui-même
store-access-own-folder = Accès : uniquement son propre dossier
store-access-any-server = Accès : se connecte à n'importe quel serveur sur Internet, jamais à votre ordinateur ni à votre réseau local
store-access-hosts = Accès : se connecte à { $list }
store-access-files = Accès : lit et écrit vos fichiers dans { $list }
store-access-programs = Accès : lance { $list }
store-access-sockets = Accès : se connecte à { $list }
store-access-any-server-ports = Accès : se connecte à n'importe quel serveur sur Internet sur le port { $list }, jamais à votre ordinateur ni à votre réseau local
store-uses-service = Utilise un service payant : { $tier }
store-paid-features = A ses propres fonctions payantes
store-frozen = Mises à jour suspendues : l'inscription de son développeur dans le store a expiré. C'est la dernière version publiée tant qu'elle était active.
store-needs-app = Nécessite sicompass { $version } ou plus récent
store-more-access = Cette mise à jour demande plus d'accès que la version installée
store-revoked = Cette version a été retirée et ne peut pas être installée
store-install = installer
store-update = mettre à jour vers { $version }
store-approve-update = approuver le nouvel accès et mettre à jour vers { $version }
store-uninstall = désinstaller
store-working = En cours
store-busy = Le store est occupé à autre chose, réessayez quand ce sera terminé
store-installed = { $name } { $version } est installé
store-updated = { $name } est mis à jour vers { $version }
store-uninstalled = { $name } est désinstallé. Son dossier de données est conservé.
store-failed = { $name } : { $err }
store-by-hand = Installé à la main. Les mises à jour viennent de { $url }, signées avec la clé utilisée à l'installation. Une nouvelle clé signifie le réinstaller à la main.
store-by-hand-no-updates = Installé à la main, sans adresse de mise à jour, le store ne peut donc pas le mettre à jour
store-state-system = fourni par cet ordinateur, version { $version }
store-system = Fourni par la configuration de cet ordinateur, depuis { $path }. Il s'exécute sans demander et change quand cette configuration change, le store ne le met donc pas à jour et ne le supprime pas.
store-system-refused = { $name } est fourni par la configuration de cet ordinateur, le store n'y touche donc pas.
store-data-kept = Son dossier de données est conservé dans { $path }
store-trash-data = déplacer son dossier de données vers la corbeille
store-data-trashed = Son dossier de données a été déplacé vers la corbeille.

# Store > abonnements (déplacé depuis les Paramètres).
store-tiers = abonnements
store-tier-sponsor = Sponsor
store-tier-cloud = Sicompass Cloud
store-tier-commercial = Sicompass Commercial
store-tier-support = Support
store-tier-status-missing = inactif
store-tier-status-active = actif pour { $licensee }, se renouvelle dans { $days } jours
store-tier-status-grace = expiré, encore actif { $days } jours, renouvelez pour le garder
store-tier-status-expired = expiré il y a { $days } jours
store-label-server-url = URL du serveur du store
store-loading-page = Chargement de cette page depuis le serveur du store. Appuyez à nouveau sur Gauche puis Droite dans un instant.
store-tier-page-failed = Cette page n'a pas pu être chargée depuis le serveur du store : { $err }
# Sur les pages Sicompass Cloud et Commercial, et après un paiement.
store-tier-turns-on = Payer active la synchronisation cloud pour { $plugins }, et pour les plugins que vous installerez plus tard qui l'utilisent.
store-tier-turns-on-later = Payer active la synchronisation cloud pour les plugins que vous installez qui l'utilisent.
store-tier-turned-on = La synchronisation cloud est activée pour { $plugins }.

# Store > publish : un développeur soumet son plugin.
store-publish = publier
store-publish-needs = Inscrire un plugin dans le store demande Sicompass Cloud ou Sicompass Commercial, sous abonnements.
store-publish-needs-active = Inscrire un plugin dans le store demande Sicompass Cloud ou Sicompass Commercial. Le vôtre est actif et se renouvelle dans { $days } jours.
store-publish-needs-grace = Inscrire un plugin dans le store demande Sicompass Cloud ou Sicompass Commercial. Le vôtre a expiré, il reste { $days } jours de grâce. Renouvelez-le sous abonnements.
store-publish-yours = vos plugins
store-publish-form = soumettre un plugin
store-publish-how = Comment ça marche : chaque plugin est relu à la main avant d'être inscrit. Il ne doit jamais bloquer ce que les gens ont créé avec lui, et il doit dire quelles fonctions sont payantes. Une fois inscrit, chaque nouvelle version arrive d'elle-même dans le store. Si votre abonnement expire, les mises à jour sont suspendues à la dernière version publiée tant qu'il était actif, jusqu'à ce que vous le renouveliez.
store-publish-label-name = nom du plugin
store-publish-label-repo = dépôt
store-publish-repo-hint = Le dépôt s'écrit propriétaire/nom, comme sur GitHub, et contient les versions du plugin.
store-publish-label-key = clé publique
store-publish-send = soumettre pour relecture
store-publish-sending = Envoi en cours.
store-publish-sent = { $name } est envoyé. Il apparaît ici comme inscrit dès qu'il a été relu et qu'il est dans le store.
store-publish-no-token = Échangez d'abord votre jeton Sicompass Cloud ou Sicompass Commercial sous abonnements.
store-publish-loading = Chargement de vos plugins.
store-publish-mine-failed = Vos plugins n'ont pas pu être chargés : { $err }
store-publish-none = Vous n'avez encore soumis aucun plugin.
store-publish-state-listed = inscrit
store-publish-state-paused = inscrit, mises à jour suspendues
store-publish-state-waiting = en attente de relecture
store-publish-state-declined = non accepté
store-publish-state-checking = vérification de la liste du store
store-publish-repo = Dépôt : { $repo }
store-publish-key = Clé publique : { $key }
store-publish-paused = Les mises à jour sont suspendues parce que votre abonnement a expiré. Renouvelez-le sous abonnements et elles reprennent à la prochaine vérification.
store-publish-declined = Il n'a pas été accepté. La relecture dit pourquoi.
store-publish-waiting = En attente de relecture. Vous pouvez suivre la relecture et y répondre sur GitHub.
store-publish-open-review = ouvrir la relecture sur GitHub
