# Store provider strings, Belgian Dutch (Flemish).

store-display-name = store
store-programs = programma's
store-loading = De storelijst wordt geladen. Druk zo meteen opnieuw op Links en Rechts.
store-load-failed = De storelijst kon niet geladen worden: { $err }
store-offline = Offline, dit is dus de storelijst die in deze versie van sicompass zit.
store-check-again = opnieuw kijken
store-checking = De store wordt nagekeken op nieuwere versies.
store-no-programs = De store biedt nog geen programma's aan.
store-state-not-installed = niet geïnstalleerd
store-state-installed = geïnstalleerd, versie { $version }
store-state-update = geïnstalleerd, versie { $version }, versie { $new } beschikbaar
store-state-frozen = updates gepauzeerd
store-state-data-waiting = niet geïnstalleerd, je gegevens ervan staan op deze computer
store-state-used-before = niet geïnstalleerd, je gebruikte het eerder
store-data-waiting = Je gegevens ervan staan op deze computer, in { $path }. Installeren opent die gegevens opnieuw.
store-data-waiting-root = Niet geïnstalleerd, maar je gebruikte ze eerder: { $names }. Ze zaten in sicompass tot versie 0.2 en komen nu uit de store. Installeer ze onder programma's om verder te gaan waar je gebleven was.
store-release-unavailable = De laatste release kon niet gecontroleerd worden: { $err }
store-version = Laatste versie: { $version }
store-version-frozen = Versie: { $version }
store-category = Categorie: { $category }
store-state-not-approved = geïnstalleerd, versie { $version }, niet goedgekeurd
store-not-approved = Draait niet: je hebt deze versie nog niet goedgekeurd.
store-approve = Goedkeuren en starten
store-access-program = Draait als programma op deze computer, met jouw rechten. Wat volgt is wat het zegt te doen, en sicompass kan het daar niet aan houden.
store-access-none = Toegang: niets buiten het programma zelf
store-access-own-folder = Toegang: alleen zijn eigen map
store-access-any-server = Toegang: maakt verbinding met elke server op het internet, nooit met je eigen computer of lokale netwerk
store-access-hosts = Toegang: maakt verbinding met { $list }
store-access-files = Toegang: leest en schrijft je bestanden in { $list }
store-access-programs = Toegang: start { $list }
store-access-sockets = Toegang: maakt verbinding met { $list }
store-access-any-server-ports = Toegang: maakt verbinding met elke server op het internet op poort { $list }, nooit met je eigen computer of lokale netwerk
store-uses-service = Gebruikt een betaalde dienst: { $tier }
store-paid-features = Heeft eigen betaalde functies
store-frozen = Updates gepauzeerd: de vermelding van de ontwikkelaar in de store is verlopen. Dit is de laatste versie die verscheen terwijl ze actief was.
store-needs-app = Heeft sicompass { $version } of nieuwer nodig
store-more-access = Deze update vraagt meer toegang dan de geïnstalleerde versie
store-revoked = Deze release is ingetrokken en kan niet geïnstalleerd worden
store-install = installeren
store-update = bijwerken naar { $version }
store-approve-update = de nieuwe toegang goedkeuren en bijwerken naar { $version }
store-uninstall = verwijderen
store-working = Bezig
store-busy = De store is met iets anders bezig, probeer opnieuw als dat klaar is
store-installed = { $name } { $version } is geïnstalleerd
store-updated = { $name } is bijgewerkt naar { $version }
store-uninstalled = { $name } is verwijderd. Zijn gegevensmap blijft bewaard.
store-failed = { $name }: { $err }
store-by-hand = Met de hand geïnstalleerd. Updates komen van { $url }, ondertekend met de sleutel waarmee het geïnstalleerd werd. Een nieuwe sleutel betekent het opnieuw met de hand installeren.
store-by-hand-no-updates = Met de hand geïnstalleerd, zonder updateadres, dus de store kan het niet bijwerken
store-state-system = geleverd door deze computer, versie { $version }
store-system = Geleverd door de configuratie van deze computer, uit { $path }. Het draait zonder te vragen en verandert wanneer die configuratie verandert, dus de store werkt het niet bij en verwijdert het niet.
store-system-refused = { $name } wordt geleverd door de configuratie van deze computer, dus de store laat het met rust.
store-data-kept = Zijn gegevensmap blijft bewaard in { $path }
store-trash-data = zijn gegevensmap naar de prullenbak verplaatsen
store-data-trashed = Zijn gegevensmap is naar de prullenbak verplaatst.

# Store > tiers (verhuisd uit Instellingen).
store-tiers = abonnementen
store-tier-sponsor = Sponsor
store-tier-cloud = Sicompass Cloud
store-tier-commercial = Sicompass Commercial
store-tier-support = Support
store-tier-status-missing = niet actief
store-tier-status-active = actief voor { $licensee }, verlengt over { $days } dagen
store-tier-status-grace = verlopen, nog { $days } dagen aan, vernieuw om het te houden
store-tier-status-expired = { $days } dagen geleden verlopen
store-label-server-url = storeserver-URL
store-loading-page = Deze pagina wordt van de storeserver geladen. Druk zo meteen opnieuw op Links en Rechts.
store-tier-page-failed = Deze pagina kon niet van de storeserver geladen worden: { $err }
# Op de pagina's Sicompass Cloud en Commercial, en na een betaling.
store-tier-turns-on = Betalen zet cloudsynchronisatie aan voor { $plugins }, en voor de plugins die je later installeert en die het gebruiken.
store-tier-turns-on-later = Betalen zet cloudsynchronisatie aan voor de plugins die je installeert en die het gebruiken.
store-tier-turned-on = Cloudsynchronisatie staat aan voor { $plugins }.

# Store > publish: een ontwikkelaar dient een plugin in.
store-publish = publiceren
store-publish-needs = Een plugin in de store vermelden vraagt Sicompass Cloud of Sicompass Commercial, onder abonnementen.
store-publish-needs-active = Een plugin in de store vermelden vraagt Sicompass Cloud of Sicompass Commercial. De jouwe is actief en wordt over { $days } dagen verlengd.
store-publish-needs-grace = Een plugin in de store vermelden vraagt Sicompass Cloud of Sicompass Commercial. De jouwe is verlopen, met nog { $days } dagen respijt. Verleng ze onder abonnementen.
store-publish-yours = jouw plugins
store-publish-form = een plugin indienen
store-publish-how = Hoe het werkt: elke plugin wordt met de hand nagekeken voor hij vermeld wordt. Hij mag nooit afschermen wat mensen ermee maakten, en hij moet zeggen welke functies betaald zijn. Eens vermeld, komt elke nieuwe release vanzelf in de store. Verloopt je abonnement, dan worden de updates gepauzeerd bij de laatste release van toen het actief was, tot je verlengt.
store-publish-label-name = naam van de plugin
store-publish-label-repo = repository
store-publish-repo-hint = De repository schrijf je als eigenaar/naam, zoals op GitHub, en ze bevat de releases van de plugin.
store-publish-label-key = publieke sleutel
store-publish-send = indienen voor nazicht
store-publish-sending = Bezig met verzenden.
store-publish-sent = { $name } is verzonden. Hij staat hier als vermeld zodra hij nagekeken is en in de store staat.
store-publish-no-token = Wissel eerst je Sicompass Cloud- of Sicompass Commercial-token in onder abonnementen.
store-publish-loading = Je plugins worden geladen.
store-publish-mine-failed = Je plugins konden niet geladen worden: { $err }
store-publish-none = Je hebt nog geen plugin ingediend.
store-publish-state-listed = vermeld
store-publish-state-paused = vermeld, updates gepauzeerd
store-publish-state-waiting = wacht op nazicht
store-publish-state-declined = niet aanvaard
store-publish-state-checking = de lijst van de store wordt nagekeken
store-publish-repo = Repository: { $repo }
store-publish-key = Publieke sleutel: { $key }
store-publish-paused = De updates zijn gepauzeerd omdat je abonnement verlopen is. Verleng het onder abonnementen en de updates gaan verder bij de volgende controle.
store-publish-declined = Hij werd niet aanvaard. Het nazicht zegt waarom.
store-publish-waiting = Wacht op nazicht. Je kunt het nazicht volgen en beantwoorden op GitHub.
store-publish-open-review = het nazicht openen op GitHub
