# Store provider strings, English.

store-display-name = store
store-programs = programs
store-loading = Loading the store list. Press Left and Right again in a moment.
store-load-failed = The store list could not be loaded: { $err }
store-offline = Offline, so this is the store list built into this version of sicompass.
store-check-again = check again
store-checking = Checking the store for newer versions.
store-no-programs = The store lists no programs yet.
store-state-not-installed = not installed
store-state-installed = installed, version { $version }
store-state-update = installed, version { $version }, version { $new } available
store-state-frozen = updates paused
store-state-data-waiting = not installed, your data for it is on this computer
store-state-used-before = not installed, you used it before
store-data-waiting = Your data for it is on this computer, in { $path }. Installing it opens that data again.
store-data-waiting-root = Not installed, but you used them before: { $names }. They came with sicompass until version 0.2 and are installed from the store now. Install them under programs to pick up where you left off.
store-release-unavailable = Its latest release could not be checked: { $err }
store-version = Latest version: { $version }
store-version-frozen = Version: { $version }
store-category = Category: { $category }
store-state-not-approved = installed, version { $version }, not approved
store-not-approved = Not running: you have not approved this version yet.
store-approve = Approve and start it
store-access-program = Runs as a program on this computer, with your rights. What follows is what it says it does, which sicompass cannot hold it to.
store-access-none = Access: nothing outside the program itself
store-access-own-folder = Access: only its own folder
store-access-any-server = Access: connects to any server on the internet, never to your own computer or local network
store-access-hosts = Access: connects to { $list }
store-access-files = Access: reads and writes your files in { $list }
store-access-programs = Access: runs { $list }
store-access-sockets = Access: connects to { $list }
store-access-any-server-ports = Access: connects to any server on the internet on port { $list }, never to your own computer or local network
store-uses-service = Uses a paid service: { $tier }
store-paid-features = Has paid features of its own
store-frozen = Updates paused: its developer's store listing has lapsed. This is the last version released while it was active.
store-needs-app = Needs sicompass { $version } or newer
store-more-access = This update asks for more access than the installed version
store-revoked = This release was withdrawn and cannot be installed
store-install = install
store-update = update to { $version }
store-approve-update = approve the new access and update to { $version }
store-uninstall = uninstall
store-working = Working on it
store-busy = The store is busy with something else, try again when it is done
store-installed = { $name } { $version } is installed
store-updated = { $name } is updated to { $version }
store-uninstalled = { $name } is uninstalled. Its data folder is kept.
store-failed = { $name }: { $err }
store-by-hand = Installed by hand. Updates come from { $url }, signed with the key it was installed with. A new key means installing it by hand again.
store-by-hand-no-updates = Installed by hand, without an update address, so the store cannot update it
store-state-system = provided by this computer, version { $version }
store-system = Provided by this computer's configuration, from { $path }. It runs without asking, and changes when that configuration does, so the store does not update or remove it.
store-system-refused = { $name } is provided by this computer's configuration, so the store leaves it alone.
store-data-kept = Its data folder is kept at { $path }
store-trash-data = move its data folder to the trash
store-data-trashed = Its data folder was moved to the trash.

# Store > tiers (moved from Settings).
store-tiers = tiers
store-tier-sponsor = Sponsor
store-tier-cloud = Sicompass Cloud
store-tier-commercial = Sicompass Commercial
store-tier-support = Support
store-tier-status-missing = not active
store-tier-status-active = active for { $licensee }, renews in { $days } days
store-tier-status-grace = expired, still on for { $days } days, renew to keep it
store-tier-status-expired = expired { $days } days ago
store-label-server-url = store server URL
store-loading-page = Loading this page from the store server. Press Left and Right again in a moment.
store-tier-page-failed = This page could not be loaded from the store server: { $err }
# On the Sicompass Cloud and Commercial pages, and after a payment.
store-tier-turns-on = Paying turns on cloud sync for { $plugins }, and for the plugins you install later that use it.
store-tier-turns-on-later = Paying turns on cloud sync for the plugins you install that use it.
store-tier-turned-on = Cloud sync is on for { $plugins }.

# Store > publish: a developer submits their plugin.
store-publish = publish
store-publish-needs = Listing a plugin in the store needs Sicompass Cloud or Sicompass Commercial, under tiers.
store-publish-needs-active = Listing a plugin in the store needs Sicompass Cloud or Sicompass Commercial. Yours is active and renews in { $days } days.
store-publish-needs-grace = Listing a plugin in the store needs Sicompass Cloud or Sicompass Commercial. Yours has expired, with { $days } days of grace left. Renew it under tiers.
store-publish-yours = your plugins
store-publish-form = submit a plugin
store-publish-how = How it works: every plugin is reviewed by hand before it is listed. It must never lock away what people made with it, and it must say which of its features are paid. Once it is listed, each new release reaches the store by itself. If your tier lapses, updates are paused at the last release made while it was active, until you renew.
store-publish-label-name = plugin name
store-publish-label-repo = repository
store-publish-repo-hint = The repository is written owner/name, as on GitHub, and holds the plugin's releases.
store-publish-label-key = public key
store-publish-send = submit for review
store-publish-sending = Sending.
store-publish-sent = { $name } is sent. It shows as listed here once it has been reviewed and is in the store.
store-publish-no-token = Redeem your Sicompass Cloud or Sicompass Commercial token under tiers first.
store-publish-loading = Loading your plugins.
store-publish-mine-failed = Your plugins could not be loaded: { $err }
store-publish-none = You have not submitted a plugin yet.
store-publish-state-listed = listed
store-publish-state-paused = listed, updates paused
store-publish-state-waiting = waiting for review
store-publish-state-declined = not accepted
store-publish-state-checking = checking the store list
store-publish-repo = Repository: { $repo }
store-publish-key = Public key: { $key }
store-publish-paused = Updates are paused because your tier lapsed. Renew it under tiers and updates resume at the next check.
store-publish-declined = It was not accepted. The review says why.
store-publish-waiting = Waiting for review. You can follow the review and answer it on GitHub.
store-publish-open-review = open the review on GitHub
