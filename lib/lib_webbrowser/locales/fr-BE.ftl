# Web-browser provider strings — Belgian French.

webbrowser-display-name = navigateur web

# A site can put a cookie choice in front of its content. It is answered on a
# page of its own; this introduces it.
webbrowser-step-consent = Ce site pose une question sur les cookies. Choisissez une option pour continuer.
webbrowser-consent-unrecognised = Ce site affiche une page de consentement aux cookies et aucun choix n'a pu en être extrait. La page de consentement elle-même est affichée ci-dessous.
webbrowser-consent-accept-all = Accepter tous les cookies
webbrowser-consent-reject-all = Refuser tous les cookies

# Bookmarks. The marker is prepended to a bookmarked row's display text, so it
# is read out before the address; keep it short and keep the brackets.
webbrowser-bookmark-marker = [favori]
webbrowser-bookmark-added = { $url } ajouté aux favoris
webbrowser-bookmark-removed = Favori supprimé pour { $url }
webbrowser-bookmark-nothing = Aucune page à ajouter aux favoris
