{
  "name": "chatclient",
  "displayName": "chat client",
  "type": "process",
  "entry": "plugin",
  "version": "0.3.2",
  "minAppVersion": "0.2.4",
  "description": "chatclient-description",
  "markup": true,
  "settings": [
    {
      "type": "text",
      "label": "chatclient-setting-homeserver",
      "key": "chatHomeserver",
      "default": "https://matrix.org"
    },
    {
      "type": "password",
      "label": "chatclient-setting-access-token",
      "key": "chatAccessToken",
      "default": ""
    },
    {
      "type": "text",
      "label": "chatclient-setting-username",
      "key": "chatUsername",
      "default": ""
    },
    {
      "type": "password",
      "label": "chatclient-setting-password",
      "key": "chatPassword",
      "default": ""
    },
    {
      "type": "text",
      "label": "chatclient-setting-email",
      "key": "chatEmail",
      "default": ""
    }
  ],
  "permissions": {
    "storage": true,
    "allowedHosts": ["*"]
  }
}
