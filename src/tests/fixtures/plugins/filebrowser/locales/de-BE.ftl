# File-browser provider strings — Belgian German (Eastern Cantons).

filebrowser-display-name = Dateimanager

# Fehlermeldungen
filebrowser-error-redo-delete-trash-failed = Löschen wiederholen: Papierkorb fehlgeschlagen: { $err }
filebrowser-error-open-with-not-file = Öffnen mit: wählen Sie eine Datei, kein Verzeichnis
filebrowser-error-open-with-no-filename = Öffnen mit: Dateinamen konnte nicht ermittelt werden

filebrowser-description = Ihre Dateien und Ordner als Liste von Listen: durchsuchen, umbenennen, erstellen, kopieren, verschieben und löschen, alles rückgängig zu machen.
filebrowser-radio-sort-order = Sortierreihenfolge

filebrowser-tutorial = Dateimanager, aus dem Store: Ihr Dateisystem als Baum. Betreten Sie Verzeichnisse mit Rechts, benennen Sie mit i um, und erstellen, kopieren, fügen ein oder löschen Sie Elemente vor Ort. Dateien, die mit einem Punkt beginnen, sind verborgen, führen Sie den Doppelpunktbefehl show/hide hidden files aus, um sie zu sehen.
