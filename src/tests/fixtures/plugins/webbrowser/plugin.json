{
  "name": "webbrowser",
  "displayName": "web browser",
  "type": "process",
  "entry": "plugin",
  "version": "0.3.3",
  "minAppVersion": "0.2.4",
  "description": "webbrowser-description",
  "rendersPages": true,
  "markup": true,
  "settings": [
    {
      "type": "text",
      "label": "webbrowser-setting-url-history",
      "key": "urlHistorySize",
      "default": "50000"
    }
  ],
  "permissions": {
    "storage": true,
    "process": [
      "google-chrome",
      "google-chrome-stable",
      "google-chrome-beta",
      "chromium",
      "chromium-browser",
      "chrome",
      "Google Chrome",
      "Chromium",
      "Microsoft Edge",
      "Google Chrome Canary",
      "Xvfb"
    ]
  }
}
