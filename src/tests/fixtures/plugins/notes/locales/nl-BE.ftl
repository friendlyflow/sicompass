# Notities-strings — Nederlands (België).

notes-display-name = notes

notes-list-meta = lijstinfo:

notes-visibility = zichtbaarheid
notes-visibility-private = privé
notes-visibility-public = openbaar

notes-sha256 = sha256: { $hash }

notes-empty = nog geen notities, druk ctrl+a om er een te schrijven

notes-gone = deze notitie staat hier niet meer

notes-cmd-move-up = omhoog verplaatsen
notes-cmd-move-down = omlaag verplaatsen
notes-cmd-duplicate = dupliceren

# The settings checkbox that turns on mirroring the notes to the server.
notes-checkbox-cloud-backup = cloudback-up inschakelen

notes-error-meta-undeletable = de lijstinfo hoort bij de lijst en kan niet verwijderd worden
notes-error-meta-readonly = de lijstinfo kan niet bewerkt worden, wijzig de zichtbaarheid erbinnen
notes-error-unreadable = je notities konden niet gelezen worden, er is niets opgeslagen, de bestanden op schijf zijn ongewijzigd
notes-error-save = je notities konden niet opgeslagen worden

notes-description = Je eigen notities, een boom van lijsten waarin je schrijft, met een optionele cloudback-up.
notes-service = bewaart een kopie van je notities op de server van Sicompass Cloud

notes-cloud-needs-payment = cloudback-up: heeft Sicompass Cloud nodig, zie store, abonnementen
notes-cloud-active = cloudback-up: aan, verlengt over { $days } dagen
notes-cloud-grace = cloudback-up: abonnement verlopen, nog { $days } dagen aan, vernieuw in store, abonnementen
notes-cloud-expired = cloudback-up: uit, het abonnement is { $days } dagen geleden verlopen, zie store, abonnementen
notes-cloud-needs-subscription = cloudback-up heeft Sicompass Cloud nodig, zie store, abonnementen
notes-cloud-failed = cloudback-up mislukt: { $reason }
notes-error-cloud-row-undeletable = de rij van de cloudback-up is geen notitie, zet cloudback-up uit in de instellingen om ze weg te halen

notes-cmd-restore-backup = cloudback-up terugzetten
notes-restore-done = cloudback-up teruggezet
notes-restore-empty = er is geen cloudback-up om terug te zetten
notes-restore-refused = je notities zijn niet leeg, er werd niets teruggezet

notes-tutorial = Notities, uit de store: druk op ctrl+a om een notitie te schrijven, Rechts om ze te openen en opnieuw ctrl+a erin om een regel toe te voegen. Notities kunnen zo diep genest worden als u wilt en elke wijziging staat op de undo-tijdlijn. De eerste rij van een notitie is de lijstinfo, waar u instelt of de notitie privé of openbaar is.
