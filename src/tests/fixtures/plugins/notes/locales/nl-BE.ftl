# Notities-strings — Nederlands (België).

notes-display-name = notes

notes-header = kop:

notes-visibility = zichtbaarheid
notes-visibility-private = privé
notes-visibility-public = openbaar

notes-sha256 = sha256: { $hash }

notes-empty = nog geen notities, druk ctrl+a om er een te schrijven

notes-gone = deze notitie staat hier niet meer

notes-cmd-move-up = omhoog verplaatsen
notes-cmd-move-down = omlaag verplaatsen
notes-cmd-duplicate = dupliceren

# The settings checkbox that turns on mirroring the notes to the server.
notes-checkbox-cloud-backup = cloudsynchronisatie inschakelen

notes-error-header-undeletable = de kop hoort bij de lijst en kan niet verwijderd worden
notes-error-header-readonly = de kop kan niet bewerkt worden, wijzig de zichtbaarheid erbinnen
notes-error-unreadable = je notities konden niet gelezen worden, er is niets opgeslagen, de bestanden op schijf zijn ongewijzigd
notes-error-save = je notities konden niet opgeslagen worden

notes-description = Je eigen notities, een boom van lijsten waarin je schrijft, met een optionele cloudsynchronisatie.
notes-service = houdt je notities gelijk tussen je computers via de server van Sicompass Cloud

notes-cloud-needs-payment = cloudsynchronisatie: heeft Sicompass Cloud nodig, zie store, abonnementen
notes-cloud-active = cloudsynchronisatie: aan, verlengt over { $days } dagen
notes-cloud-grace = cloudsynchronisatie: abonnement verlopen, nog { $days } dagen aan, vernieuw in store, abonnementen
notes-cloud-expired = cloudsynchronisatie: uit, het abonnement is { $days } dagen geleden verlopen, zie store, abonnementen
notes-cloud-needs-subscription = cloudsynchronisatie heeft Sicompass Cloud nodig, zie store, abonnementen
notes-cloud-failed = cloudsynchronisatie mislukt: { $reason }
notes-error-cloud-row-undeletable = de rij van de cloudsynchronisatie is geen notitie, zet cloudsynchronisatie uit in de instellingen om ze weg te halen

notes-cmd-sync-now = nu synchroniseren met de cloud
notes-sync-pulled = wijzigingen van je andere computers zijn toegevoegd
notes-sync-conflicts = wijzigingen van je andere computers zijn toegevoegd, { $count } aan beide kanten bewerkt, de laatste bewerking is behouden
notes-sync-status-synced = cloud: gesynchroniseerd
notes-sync-status-changed = cloud: gewijzigd sinds de laatste synchronisatie
notes-sync-status-new = cloud: nog niet gesynchroniseerd

notes-tutorial = Notities, uit de store: druk op ctrl+a om een notitie te schrijven, Rechts om ze te openen en opnieuw ctrl+a erin om een regel toe te voegen. Notities kunnen zo diep genest worden als u wilt en elke wijziging staat op de undo-tijdlijn. De eerste rij van een notitie is de kop, waar u instelt of de notitie privé of openbaar is.
