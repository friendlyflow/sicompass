# Chaînes du fournisseur de notes — Français (Belgique).

notes-display-name = notes

notes-list-meta = info de liste :

notes-visibility = visibilité
notes-visibility-private = privé
notes-visibility-public = public

notes-sha256 = sha256 : { $hash }

notes-empty = pas encore de notes, appuyez sur ctrl+a pour en écrire une

notes-gone = cette note n'est plus ici

notes-cmd-move-up = déplacer vers le haut
notes-cmd-move-down = déplacer vers le bas
notes-cmd-duplicate = dupliquer

# The settings checkbox that turns on mirroring the notes to the server.
notes-checkbox-cloud-backup = activer la synchronisation cloud

notes-error-meta-undeletable = l'info de liste appartient à la liste et ne peut pas être supprimée
notes-error-meta-readonly = l'info de liste ne peut pas être modifiée, changez la visibilité à l'intérieur
notes-error-unreadable = vos notes n'ont pas pu être lues, rien n'a été enregistré, les fichiers sur le disque sont intacts
notes-error-save = vos notes n'ont pas pu être enregistrées

notes-description = Vos propres notes, un arbre de listes dans lesquelles vous écrivez, avec une synchronisation cloud en option.
notes-service = garde vos notes identiques sur vos ordinateurs via le serveur de Sicompass Cloud

notes-cloud-needs-payment = synchronisation cloud : demande Sicompass Cloud, voir store, abonnements
notes-cloud-active = synchronisation cloud : active, renouvellement dans { $days } jours
notes-cloud-grace = synchronisation cloud : abonnement expiré, encore active { $days } jours, renouvelez dans store, abonnements
notes-cloud-expired = synchronisation cloud : arrêtée, l'abonnement a expiré il y a { $days } jours, voir store, abonnements
notes-cloud-needs-subscription = la synchronisation cloud demande Sicompass Cloud, voir store, abonnements
notes-cloud-failed = échec de la synchronisation cloud : { $reason }
notes-error-cloud-row-undeletable = la ligne de la synchronisation cloud n'est pas une note, désactivez la synchronisation cloud dans les paramètres pour la retirer

notes-cmd-sync-now = synchroniser avec le cloud maintenant
notes-sync-pulled = les modifications de vos autres ordinateurs ont été ajoutées
notes-sync-conflicts = les modifications de vos autres ordinateurs ont été ajoutées, { $count } modifiées des deux côtés, la plus récente a été gardée
notes-sync-status-synced = cloud : synchronisé
notes-sync-status-changed = cloud : modifié depuis la dernière synchronisation
notes-sync-status-new = cloud : pas encore synchronisé

notes-tutorial = Notes, depuis le store : appuyez sur ctrl+a pour écrire une note, Droite pour l'ouvrir, et ctrl+a de nouveau à l'intérieur pour ajouter une ligne. Les notes s'imbriquent aussi profondément que vous voulez et chaque changement est sur la chronologie d'annulation. La première ligne d'une note est son info de liste, où vous définissez si la note est privée ou publique.
