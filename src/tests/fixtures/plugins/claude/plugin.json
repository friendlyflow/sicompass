{
  "name": "claude",
  "displayName": "claude",
  "type": "process",
  "entry": "plugin",
  "version": "0.3.3",
  "minAppVersion": "0.2.4",
  "description": "claude-description",
  "markup": true,
  "settings": [
    {
      "type": "radio",
      "label": "claude-radio-permission-mode",
      "key": "claudePermissionMode",
      "options": ["default", "acceptEdits", "plan", "bypassPermissions"],
      "default": "default"
    },
    {
      "type": "text",
      "label": "claude-setting-model",
      "key": "claudeModel",
      "default": ""
    },
    {
      "type": "text",
      "label": "claude-setting-extra-args",
      "key": "claudeExtraArgs",
      "default": ""
    },
    {
      "type": "checkbox",
      "label": "claude-checkbox-stream-partial",
      "key": "claudeStreamPartial",
      "defaultChecked": true
    },
    {
      "type": "text",
      "label": "claude-setting-folder",
      "key": "claudeFolder",
      "default": "~/.claude"
    }
  ],
  "permissions": {
    "storage": true,
    "filesystem": ["/"],
    "process": ["claude"]
  }
}
