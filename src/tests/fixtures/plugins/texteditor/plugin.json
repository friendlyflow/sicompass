{
  "name": "texteditor",
  "displayName": "text editor",
  "type": "process",
  "entry": "plugin",
  "version": "0.3.1",
  "minAppVersion": "0.2.0",
  "description": "texteditor-description",
  "markup": true,
  "settings": [
    {
      "type": "text",
      "label": "texteditor-setting-path",
      "key": "textEditorPath",
      "default": "~"
    },
    {
      "type": "radio",
      "label": "texteditor-radio-line-numbers",
      "key": "textEditorLineNumbers",
      "options": ["none", "absolute", "relative"],
      "default": "none"
    }
  ],
  "permissions": {
    "filesystem": ["/"]
  }
}
