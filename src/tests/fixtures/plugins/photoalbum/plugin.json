{
  "name": "photoalbum",
  "displayName": "photo album",
  "type": "process",
  "entry": "plugin",
  "version": "0.1.0",
  "minAppVersion": "0.2.4",
  "description": "photoalbum-description",
  "markup": true,
  "settings": [
    {
      "type": "text",
      "label": "photo folder (photo album)",
      "key": "photoFolder",
      "default": "Pictures"
    },
    {
      "type": "radio",
      "label": "photoalbum-radio-sort-order",
      "key": "sortOrder",
      "options": ["alphanumerically", "chronologically"],
      "default": "alphanumerically"
    }
  ],
  "permissions": {
    "filesystem": ["/"]
  }
}
