{
  "name": "projectmanagement",
  "displayName": "project management",
  "type": "process",
  "entry": "plugin",
  "version": "0.4.5",
  "minAppVersion": "0.2.4",
  "description": "projectmanagement-description",
  "markup": true,
  "settings": [
    {
      "type": "checkbox",
      "label": "projectmanagement-checkbox-cloud-backup",
      "key": "kanbanCloudBackup",
      "defaultChecked": false
    }
  ],
  "service": {
    "tier": "friendlyflow/cloud",
    "what": "projectmanagement-service",
    "switch": "kanbanCloudBackup"
  },
  "permissions": {
    "storage": true,
    "allowedHosts": ["store.sicompass.org"]
  }
}
