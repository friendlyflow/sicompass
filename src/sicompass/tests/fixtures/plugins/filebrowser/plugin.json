{
  "name": "filebrowser",
  "displayName": "file browser",
  "type": "wasm",
  "entry": "plugin.wasm",
  "version": "0.2.1",
  "minAppVersion": "0.2.0",
  "description": "filebrowser-description",
  "settings": [
    {
      "type": "radio",
      "label": "filebrowser-radio-sort-order",
      "key": "sortOrder",
      "options": ["alphanumerically", "chronologically"],
      "default": "alphanumerically"
    }
  ],
  "permissions": {
    "filesystem": ["/"]
  }
}
