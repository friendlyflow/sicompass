# Terminal provider strings — Belgian French.

terminal-display-name = terminal
terminal-description = Un vrai shell, sous forme de liste : naviguez vers un dossier, appuyez sur : pour y ouvrir un shell, et les programmes plein écran comme vim s'ouvrent dans un tableau de bord.
terminal-setting-shell = programme shell ($SHELL est votre shell de connexion)
terminal-setting-history = historique des commandes du shell
terminal-setting-scrollback = historique de défilement du terminal
terminal-setting-auto-dashboard = ouvrir automatiquement le tableau de bord pour les programmes interactifs

# Noms de commande affichés partout où les commandes du fournisseur sont listées.
terminal-command-shell = shell
terminal-command-browse = dossiers

terminal-tutorial = Terminal, depuis le store : appuyez sur : pour transformer la liste en un vrai shell qui s'exécute dans le dossier où vous êtes, avec une ligne d'entrée en bas. L'en-tête indique alors mode commande. Entrez d'abord dans un dossier avec Droite si vous voulez le shell un niveau plus bas. Échap ramène aux dossiers, et les programmes plein écran comme vim et htop reçoivent leur propre mode interactif.
