# Terminal provider strings — Belgian German (Eastern Cantons).

terminal-display-name = Terminal
terminal-description = Eine echte Shell als Liste: zu einem Ordner navigieren, : drücken für eine Shell dort, und Vollbildprogramme wie vim öffnen sich in einem Dashboard.
terminal-setting-shell = Shell-Programm ($SHELL ist Ihre Login-Shell)
terminal-setting-history = Befehlsverlauf der Shell
terminal-setting-scrollback = Scrollback des Terminal-Emulators
terminal-setting-auto-dashboard = Dashboard für interaktive Programme automatisch öffnen

# Befehlsnamen, die überall dort erscheinen, wo die Befehle des Providers
# aufgelistet werden.
terminal-command-shell = Shell
terminal-command-browse = Ordner

terminal-tutorial = Terminal, aus dem Store: Drücken Sie :, um die Liste in eine echte Shell zu verwandeln, die in dem Ordner läuft, in dem Sie gerade sind, mit einer Eingabezeile unten. Die Kopfzeile sagt dann Befehlsmodus. Gehen Sie zuerst mit Rechts in einen Ordner, wenn Sie die Shell eine Ebene tiefer möchten. Escape führt zurück zu den Ordnern, und Vollbild-Programme wie vim und htop erhalten ihren eigenen interaktiven Modus.
