// Sicompass plugin interface — the contract between the sicompass host and a
// sandboxed WASM provider.
//
// This file is CANONICAL. `sicompass-sdk` ships it (see `WIT_SOURCE` in lib.rs)
// so plugin authors always get the version their SDK matches, and the host repo
// keeps a vendored copy at `src/sicompass/wit/` with a test asserting the two are
// byte-identical.
//
// ---------------------------------------------------------------------------
// The security property this file encodes
// ---------------------------------------------------------------------------
//
// A WASM guest has no syscalls. Its entire ability to affect the outside world is
// the set of functions the host links into it. So the imports below are not a
// convenience API — they ARE the capability set, and it is deliberately tiny.
//
// Capabilities are split across two interfaces rather than one, because wasmtime
// links host functions an interface at a time: `interface host` is always linked,
// and `interface net` is linked ONLY when a plugin's `plugin.json` declares a
// non-empty `allowedHosts`. Omit the field and a component referencing `net` fails
// to instantiate. Not blocked by policy at call time — absent from the instance.
//
// Because LTO drops unused imports, a built component's import list also *reveals*
// what it can do, so the host can compare it against the manifest's declaration and
// reject a mismatch before instantiating anything.
//
// Guests target `wasm32-wasip2`, whose `std` imports WASI p2 interfaces of its own
// (cli stdio, environment and exit, clocks, io, and filesystem when used). This
// world does not name them: the host links a fixed **baseline** of WASI that
// grants no authority by itself, and gates the rest by `plugin.json`:
//
//   baseline (always, inert): wasi:cli (empty environment and stdin, stdout and
//     stderr into the host log, never a terminal), wasi:clocks, wasi:random,
//     wasi:io, and wasi:filesystem with NO preopens, so it reaches nothing.
//   gated: filesystem preopens (`storage`, `filesystem`), wasi:sockets
//     (`sockets`), and the sicompass interfaces below that say so.
//
// The rule is unchanged from 0.1: every import that grants authority is linked
// only when the manifest grants it, and the host audits a component's imports
// against its manifest before instantiating it. Unknown imports are never
// stubbed as traps. See sicompass's docs/plugin-platform.md.
//
// ---------------------------------------------------------------------------
// Two representation decisions worth knowing before you read on
// ---------------------------------------------------------------------------
//
// 1. FFON crosses as an opaque byte blob, not a WIT record. WIT has no recursive
//    types and `FfonElement` is a tree. Rather than invent a flattening, the blob
//    uses the SDK's existing, already-tested binary codec
//    (`ffon::serialize_binary` / `ffon::deserialize_binary`). Guests get the same
//    codec from `sicompass-sdk` with `default-features = false`.
//
//    Deliberately NOT the JSON encoding the old `bun` script protocol used:
//    `ffon::parse_json_value` is lossy on purpose (numbers and `null` coerce to
//    strings), which is fine for a hand-written `.ts` file and wrong for an ABI.
//
// 2. Some read-only trait methods are batched rather than mirrored one-to-one.
//    The host calls `tick` + `take-dashboard-request` + `take-navigation-request` +
//    `needs-refresh` + `take-error` for every provider on every frame; mirroring
//    that shape would mean 5 boundary crossings per provider at 60fps, which is
//    the difference between viable and not (especially under the Pulley
//    interpreter). So:
//      - static flags  -> one `describe()` call, made once after `init`
//      - per-frame state -> one `poll()` call, cached by the host
//      - path mutators return the resulting path, so `current-path` needs no call
//    The observable behaviour is identical, including the documented two-call
//    semantics of the `take-*` requests (the host `take()`s its cached option).

package sicompass:plugin@0.2.0;

// ---------------------------------------------------------------------------
// Shared data types
// ---------------------------------------------------------------------------

interface types {
  /// A list of `FfonElement`s in the SDK's binary codec. A single element is
  /// encoded as a one-element list, so there is exactly one codec to implement.
  type ffon = list<u8>;

  /// An item in a command's selection list (e.g. applications for "open with").
  record list-item {
    label: string,
    data: string,
  }

  /// A result item from extended search (Ctrl+F).
  record search-result {
    /// Display label with prefix, e.g. `"- report.pdf"`, `"+ docs"`.
    label: string,
    /// Relative path context, e.g. `"docs > projects > "`.
    breadcrumb: string,
    /// Absolute navigation path for teleport.
    nav-path: string,
  }

  /// What kind of fullscreen view the provider supports when the user presses `d`.
  enum dashboard-kind {
    /// Pressing `d` is a no-op.
    none,
    /// Static image; the host reads, scales and centers the path from
    /// `dashboard-image-path`.
    image,
    /// Cell grid driven by per-frame `dashboard-render`.
    interactive,
  }

  /// Per-cell text attributes. Only `reverse` is honoured today.
  record cell-attrs {
    bold: bool,
    underline: bool,
    reverse: bool,
  }

  /// One character cell. Colours are packed `0xRRGGBBAA`. An alpha of 0 in `bg`
  /// means "draw no background fill".
  record cell {
    ch: char,
    fg: u32,
    bg: u32,
    attrs: cell-attrs,
  }

  /// A snapshot of the provider's cell grid for one frame. `cells` is row-major
  /// with length `cols * rows`; the host rejects a frame that disagrees.
  /// `cursor` is `(col, row)`, 0-indexed; absent hides the cursor.
  record frame {
    cols: u16,
    rows: u16,
    cells: list<cell>,
    cursor: option<tuple<u16, u16>>,
    /// The one region the host paints as a selection, if any.
    selection: option<selection>,
    /// Rows after which the host leaves half a line height of extra space.
    half-gap-rows: list<u16>,
    /// How to draw `cursor`.
    cursor-style: cursor-style,
  }

  /// A rectangle of cells, in cells.
  record selection {
    col: u16,
    row: u16,
    cols: u16,
    rows: u16,
  }

  enum cursor-style {
    block,
    bar,
  }

  /// The host's active colours, packed `0xRRGGBBAA`, handed to the provider
  /// before each `dashboard-render` so a dashboard matches the list around it
  /// in either theme.
  record palette {
    background: u32,
    text: u32,
    header-sep: u32,
    selected: u32,
    ext-search: u32,
    scroll-search: u32,
    error: u32,
  }

  /// Keys the host maps SDL keycodes onto. Deliberately small: printable input
  /// arrives through `dashboard-text`, and `ch` is only for when modifiers
  /// suppress the text-input event (e.g. Ctrl+letter, stored lowercase).
  variant keysym {
    enter,
    backspace,
    tab,
    escape,
    up,
    down,
    left,
    right,
    home,
    end,
    page-up,
    page-down,
    insert,
    delete,
    %f(u8),
    ch(char),
    /// Anything unrecognised. Providers should generally ignore this.
    unknown,
  }

  record key {
    sym: keysym,
    ctrl: bool,
    shift: bool,
    alt: bool,
  }

  /// A request to switch dashboard mode outside a user keypress — e.g. a terminal
  /// noticing a child program emitted `ESC[?1049h`. Honoured only for the active
  /// provider, so a background tab can never yank the user away.
  enum dashboard-request {
    enter,
    leave,
  }

  /// A cursor move requested outside a keypress, for when background work
  /// finishing would otherwise strand the user on a stale row.
  variant navigation-request {
    /// Descend into the children of the current element, as if Right were pressed.
    enter-children,
    /// Put the list cursor on this row: indices at each level below the
    /// provider's own top level.
    select-path(list<u32>),
  }

  /// What happened to a background task.
  variant task-event {
    /// Bytes the task passed to `tasks.emit`, in order.
    progress(list<u8>),
    /// The task ended: `run-task`'s result, or why it stopped (cancelled,
    /// trapped, out of memory).
    done(result<list<u8>, string>),
  }

  /// A reversible action, for the unified undo/redo timeline.
  ///
  /// This is `TimelineEntry::ProviderOp` and only that. The typed variants
  /// (`FsOp`, `ImapOp`, `ChatOp`, `Structural`, `TextChunk`, `Navigate`) stay
  /// host-only: they carry side effects the host would have to replay on the
  /// guest's behalf, and `FsSideEffect::TrashedDir` embeds a recursive directory
  /// tree plus megabytes of file content. `provider-idx` is filled in by the host,
  /// which is the only side that knows it.
  record provider-op {
    command: string,
    payload: ffon,
    label: string,
  }

  /// Values that do not change over a provider's lifetime. Fetched once, right
  /// after `init`, instead of one call per accessor per use.
  record descriptor {
    /// Stable identifier. Must match the `name` in `plugin.json`.
    name: string,
    /// Localized text shown in the UI.
    display-name: string,
    /// Shown in the settings tree. Usually left absent, since the host prefers
    /// `plugin.json`'s `version` field.
    version: option<string>,
    /// Enable Ctrl+S / Ctrl+O save and load.
    supports-config-files: bool,
    /// Always re-fetch on navigation.
    no-cache: bool,
    /// `current-path` is a real slash-separated filesystem path, so the timeline
    /// view renders it verbatim rather than as a breadcrumb.
    path-is-filesystem: bool,
    /// Always label the provider root with `display-name`, regardless of depth.
    stable-root-key: bool,
    /// Behaves like a text editor: leaving Insert commits via `commit-edit`, and
    /// the meta/scroll hint screens are suppressed.
    has-editor-semantics: bool,
    /// Opt in to the generic structural-edit keymap: Ctrl+I / Ctrl+A insert,
    /// Ctrl+D / Delete remove, Ctrl+X / Ctrl+C / Ctrl+V cut, copy and paste.
    /// The host owns the mutation and reports the result back through
    /// `sync-ffon-body-children`; `delete-item` and `commit-edit` keep their
    /// veto. Weaker than `has-editor-semantics`, which also remaps Enter.
    supports-structural-edit: bool,
    /// Whether pressing `d` may enter the dashboard. When false the dashboard can
    /// still be entered via a `dashboard-request`.
    manual-dashboard-entry-allowed: bool,
    dashboard-kind: dashboard-kind,
    /// While the dashboard is open, Ctrl+Z and Ctrl+Y undo and redo through
    /// the app's timeline (this provider's `undo` / `redo`) instead of being
    /// forwarded as keys. It can only take keys away from the guest, never
    /// give it more, which is why a sandboxed provider may set it.
    dashboard-uses-app-undo: bool,
  }

  /// Everything the host needs from a provider once per frame, in one call.
  record poll-result {
    /// Background state advanced; the view needs a redraw. (`tick`)
    redraw: bool,
    /// Cross-thread refresh signal. (`needs-refresh`)
    needs-refresh: bool,
    /// Work in flight the user would not want to lose by closing the tab; the
    /// host confirms before tearing the provider down on Ctrl+W. (`is-busy`)
    is-busy: bool,
    /// Whether the user is still at the provider's logical root. (`at-root`)
    at-root: bool,
    /// A pending error to surface as a row. (`take-error`)
    error: option<string>,
    /// A line for the screen reader: not an error, not shown as a row, and
    /// spoken only for the active provider. (`take-announcement`)
    announcement: option<string>,
    /// (`take-dashboard-request`)
    dashboard-request: option<dashboard-request>,
    /// (`take-navigation-request`)
    navigation-request: option<navigation-request>,
    /// Whether structural editing (insert, delete, cut and paste of rows) is
    /// available at the current path. Narrows `descriptor.supports-structural-edit`,
    /// which says whether it ever is. The host polls again right after each
    /// `push-path`, `pop-path` and `set-current-path`, so this is never a level
    /// behind.
    structural-edit-here: bool,
    /// Whether the dashboard (`d`) is offered at the current path. Narrows
    /// `descriptor.dashboard-kind` in the same way.
    dashboard-here: bool,
  }
}

// ---------------------------------------------------------------------------
// Host imports — the complete capability set
// ---------------------------------------------------------------------------

/// Always linked. Nothing here grants ambient authority: no ambient filesystem, no
/// ambient network, no way to observe or affect anything outside this plugin.
///
/// `read-asset` is the one function here that touches a disk, and it is not an
/// exception to that sentence. The only reachable bytes are files under `assets/`
/// in the plugin's own install directory: files the plugin itself shipped and the
/// user installed. There is no authority in that for `plugin.json` to declare, which
/// is why it sits here rather than behind a gate like `net`. The import still
/// *appears* in a built component's import list, so an audit can still see that a
/// plugin reads its own data.
interface host {
  /// Write a diagnostic line to the host log, prefixed with the plugin name.
  log: func(msg: string);

  /// Read one of the settings this plugin declared in `plugin.json`. Scoped to
  /// that plugin's own keys — not arbitrary access to the user's config.
  get-setting: func(key: string) -> option<string>;

  /// Milliseconds since the Unix epoch. Kept for guests built before `std`'s
  /// clocks (the baseline `wasi:clocks`) were available; either works.
  now-millis: func() -> u64;

  /// Look up a key in the host's Fluent bundles, so a plugin's user-visible text
  /// localizes through the same path a built-in's does. A plugin ships its own
  /// messages in `locales/<lang>.ftl`, every id prefixed with `<name>-`.
  translate: func(key: string) -> string;

  /// `translate` with Fluent arguments, e.g. `("count", "3")`.
  translate-args: func(key: string, args: list<tuple<string, string>>) -> string;

  /// Read one of this plugin's own data files.
  ///
  /// `rel` is resolved inside `assets/` in the plugin's install directory, so
  /// `read-asset("equipment.json")` reads `<plugin-dir>/assets/equipment.json`.
  ///
  /// `none` means refused *or* absent, deliberately indistinguishable: a guest
  /// cannot turn this into a probe for what exists on the host filesystem.
  /// Refused are absolute paths, anything containing `..`, anything that resolves
  /// (after symlinks) outside `assets/`, anything that is not a regular file, and
  /// anything larger than 16 MiB — a guest's memory is capped, so a bigger file
  /// could not be received anyway.
  ///
  /// For an image the *host* should render, do not read it here. Put
  /// `asset:<plugin-name>/<file>` in an `<image>` tag and let the host resolve it:
  /// no copy through guest memory, no decoding in the guest.
  read-asset: func(rel: string) -> option<list<u8>>;

  /// Where the plugin is now, after a call that moved it other than through
  /// `push-path`, `pop-path` or `set-current-path` (which return the path): a
  /// command, an edit, background work such as a shell's `cd`. The pdk's
  /// `export_plugin!` calls it itself whenever `current_path` changed.
  moved-to: func(path: string);
}

/// Network egress. **A separate interface from `host` on purpose.**
///
/// The host links this interface into a plugin only when that plugin's
/// `plugin.json` declares a non-empty `allowedHosts`. Interface granularity is what
/// makes that enforceable: wasmtime links host functions an interface at a time, so
/// keeping `fetch` in `host` would have meant "link `log`" and "link `fetch`" were
/// the same decision.
///
/// A component that references anything here without declaring `allowedHosts` fails
/// to instantiate. The capability is absent, not denied at call time.
interface net {
  use types.{ffon};

  record http-request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  }

  record http-response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// The ONLY network egress available to a plugin.
  ///
  /// The host enforces, per call: the `allowedHosts` allowlist, robots.txt
  /// `Disallow` (block) and `Crawl-delay` (rate-limit), and per-domain request
  /// quotas. A plugin cannot opt out of any of it, because there is no other way
  /// out of the sandbox.
  fetch: func(req: http-request) -> result<http-response, string>;

  /// Fetch a URL and get it back as an FFON tree, reusing the host's HTML->FFON
  /// pipeline rather than making every plugin reimplement it. Same policy checks as
  /// `fetch`.
  fetch-url-ffon: func(url: string) -> result<ffon, string>;
}

/// The user's desktop, reached through the host. Always linked: every path it
/// takes must lie inside a directory this plugin was granted (its `storage`
/// folder, or a `filesystem` folder the user approved), re-checked by the host
/// after resolving symlinks, so it reaches nothing the plugin could not already
/// read and write. A plugin with no granted folder can only open URLs.
/// Where the user stands with a paid tier, and the credential for the tier's
/// server. The host verifies the user's certificate for `tier` against the
/// issuer key the signed store list names for that tier; the plugin never sees
/// a key or a certificate. A plugin that offers a paid service (its
/// `plugin.json` names it as `service.tier`) uses this to show where the user
/// stands and to authenticate to that service. Never gate the user's data
/// behind it: what is paid is the service, not the plugin.
interface license {
  enum tier-status {
    /// A valid certificate, not expired.
    active,
    /// Expired less than 14 days ago: keep the feature on, and say so.
    grace,
    expired,
    /// No valid certificate for this tier.
    missing,
  }

  /// Where the user stands, with a day count: until renewal when active, left
  /// when in grace, since expiry when expired, 0 when missing.
  record tier-standing {
    status: tier-status,
    days: s32,
  }

  /// `tier` is a tier id from the store list, e.g. `acme/pro`.
  status: func(tier: string) -> tier-status;

  standing: func(tier: string) -> tier-standing;

  /// The user's redeem token for `tier`: the bearer credential for that tier's
  /// server. Only for the tier this plugin's `plugin.json` names as its
  /// `service`; `none` for any other, and when the user has not redeemed one.
  token: func(tier: string) -> option<string>;
}

interface desktop {
  /// Open a URL in the user's browser or mail client. `http`, `https` and
  /// `mailto` only.
  open-url: func(url: string) -> result<_, string>;

  /// What a browser sign-in came back with.
  record oauth-reply {
    /// The redirect URI the sign-in used, which the token request repeats.
    redirect-uri: string,
    /// The query the provider redirected with: `code=...&state=...`, or an
    /// `error=...`. Still percent-encoded.
    query: string,
  }

  /// Sign in through the user's browser, the way a desktop app does OAuth 2
  /// (RFC 8252): the host listens once on a loopback port, opens `auth-url`
  /// (`https` only) with every `{redirect-uri}` in it replaced by
  /// `http://127.0.0.1:<port>`, percent-encoded, and waits for the browser to
  /// come back, `timeout-secs` at most. A plugin never listens itself.
  ///
  /// It waits, so it is refused outside a task (`tasks.spawn`), and cancelling
  /// that task ends the wait.
  oauth-redirect: func(auth-url: string, timeout-secs: u32) -> result<oauth-reply, string>;

  /// Open a file with the application the user's desktop associates with it.
  open-path: func(path: string) -> result<_, string>;

  /// Move a file or directory to the OS trash, so the user can get it back.
  trash: func(path: string) -> result<_, string>;

  /// Restore the most recently trashed item whose original location was
  /// `path`, for an undo. Fails where the OS offers no programmatic restore.
  restore: func(path: string) -> result<_, string>;

  /// The target of the symlink at `path`, as written in the link. WASI never
  /// follows (or even reads) a link with an absolute target, so a plugin with
  /// a folder grant asks here to follow one itself. `path` must lie inside a
  /// granted folder; the target may point anywhere, and reaching it is still
  /// subject to the grants. Fails when `path` is not a symlink.
  read-link: func(path: string) -> result<string, string>;

  /// An application installed on the user's system.
  record application {
    /// What the user reads, e.g. "Firefox".
    name: string,
    /// What `open-with` takes. Opaque: only ids from `applications` work.
    id: string,
  }

  /// The applications installed on the user's system, for an "open with"
  /// choice. May be empty (a headless machine).
  applications: func() -> list<application>;

  /// Open the file at `path` with application `id` from `applications`.
  /// `path` must lie inside a granted folder. An id the host did not list is
  /// refused, so this starts only what the user has installed as an
  /// application, never an arbitrary program.
  open-with: func(id: string, path: string) -> result<_, string>;

  /// What `ls -l` shows for an entry.
  record file-info {
    size: u64,
    /// Last modified, seconds since the Unix epoch.
    modified: s64,
    /// The user's UTC offset at `modified`, in seconds east. A plugin has no
    /// time zone of its own, so this is how it shows a local time.
    utc-offset: s32,
    /// Type and permission bits (`st_mode`), where the system has them.
    mode: option<u32>,
    /// Hard links, where the system has them.
    links: option<u64>,
    /// Owner and group names (the number when a name is unknown), where the
    /// system has them.
    owner: option<string>,
    group: option<string>,
  }

  /// The entry at `path` itself (a symlink is not followed), which must lie
  /// inside a granted folder. WASI's own metadata has no permission bits,
  /// owner or group.
  stat: func(path: string) -> result<file-info, string>;
}

/// Background work. Every call into a provider runs on the UI thread under a
/// 10-second deadline, so anything slower (a mail sync, a long poll, an upload,
/// `git status` on a big repository) runs as a task instead.
///
/// A task is a **fresh instance of this same component** on a worker thread,
/// with the same grants and no shared memory: `init` is not called, and
/// `run-task` gets only its `input`. It reports through `emit` and its result,
/// which the host delivers to the UI instance through `on-task-event`, just
/// before the next `poll`. It has no deadline, but stops at its next epoch tick
/// once cancelled, and `cancelled` lets a loop exit cleanly. At most 4 tasks run
/// per plugin; further ones wait. Always linked: a task can do nothing the
/// plugin could not already do, only for longer.
interface tasks {
  /// From the UI instance: start task `name` with `input`. Returns its id.
  /// Refused from inside a task.
  spawn: func(name: string, input: list<u8>) -> result<u64, string>;

  /// Ask a task to stop. Harmless for an id that already finished.
  cancel: func(id: u64);

  /// From inside a task: report progress. Ignored in the UI instance.
  emit: func(event: list<u8>);

  /// From inside a task: whether it has been asked to stop.
  cancelled: func() -> bool;

  /// From the UI instance: send `message` to task `id`, running or still
  /// queued. It arrives in that task's `receive`, in order. Refused once the
  /// task has ended, and while it has a backlog it is not reading. With this
  /// a task can live as long as the plugin, holding a connection or a program
  /// and doing what the UI asks of it, without the UI's 10-second deadline.
  send: func(id: u64, message: list<u8>) -> result<_, string>;

  /// From inside a task: the next message the UI instance sent, waiting up to
  /// `timeout-ms` (a minute at most) for one. None when none came in time, or
  /// the task was asked to stop.
  receive: func(timeout-ms: u32) -> option<list<u8>>;
}

/// Programs on the user's machine. **The one interface that reaches outside the
/// sandbox**: a started program runs with the user's full rights, so it is held
/// the tightest. Linked only when `plugin.json` lists programs in
/// `permissions.process`, and only those can start (by name, resolved on `PATH`
/// when started; `$SHELL` is the user's login shell). The user approves the list.
///
/// The program gets the host's environment plus the `env` given here (the
/// plugin's own environment stays empty), and a working directory that must lie
/// inside a folder the plugin was granted (default: the user's home). Reads never
/// block, so a terminal reads its PTY from `poll`.
interface process {
  /// A terminal size, in cells.
  record pty-size {
    rows: u16,
    cols: u16,
  }

  /// Where `program` (a name `permissions.process` lists) would start from,
  /// the file `spawn` resolves it to. Knowing a path grants nothing: reading
  /// the file still needs a folder grant.
  which: func(program: string) -> result<string, string>;

  resource child {
    /// Start `program`. With `pty`, it runs attached to a new pseudo-terminal of
    /// that size (stdout and stderr both arrive through `read`); without, its
    /// stdin, stdout and stderr are pipes.
    ///
    /// The program inherits sicompass's environment (the user's `PATH`,
    /// `HOME`, SSH agent and so on). `env` sets variables on top of it, and
    /// `unset` removes inherited ones: a plugin that must not be steered by,
    /// say, a stray `GIT_DIR` removes it here.
    spawn: static func(
      program: string,
      args: list<string>,
      cwd: option<string>,
      env: list<tuple<string, string>>,
      unset: list<string>,
      pty: option<pty-size>,
    ) -> result<child, string>;

    /// `spawn` on pipes, plus a private message channel: the program reads
    /// what `channel-write` sends on file descriptor 3, and what it writes to
    /// file descriptor 4 is what `channel-read` returns. That is Chrome's
    /// `--remote-debugging-pipe`, which lets a plugin drive a browser with no
    /// network port anything else on the machine could reach. Unix only.
    spawn-with-channel: static func(
      program: string,
      args: list<string>,
      cwd: option<string>,
      env: list<tuple<string, string>>,
      unset: list<string>,
    ) -> result<child, string>;

    /// Up to `max` bytes of output so far (the PTY, or stdout). Never blocks;
    /// empty when there is nothing new.
    read: func(max: u32) -> list<u8>;

    /// Up to `max` bytes the program wrote to its channel so far (see
    /// `spawn-with-channel`). Never blocks. Always empty without a channel.
    channel-read: func(max: u32) -> list<u8>;

    /// Send bytes to the program's channel.
    channel-write: func(bytes: list<u8>) -> result<_, string>;

    /// Up to `max` bytes of stderr so far. Always empty with a PTY.
    read-stderr: func(max: u32) -> list<u8>;

    /// Send input (to the PTY, or stdin).
    write: func(bytes: list<u8>) -> result<_, string>;

    /// Resize the PTY. Ignored without one.
    resize: func(size: pty-size);

    /// The exit code once it has exited (-1 when killed by a signal) and its
    /// output has arrived, so the `read`s after this return the rest of it.
    /// (A program it left running in the background can hold its output open;
    /// the exit is reported half a second later regardless.)
    try-wait: func() -> option<s32>;

    /// Its working directory right now, which a shell's `cd` moves. Absent
    /// once it has exited, and where the system does not say (only Linux
    /// does, today).
    cwd: func() -> option<string>;

    /// Whether a program it started holds its terminal's foreground: a shell
    /// running a command rather than sitting at its prompt. False without a
    /// PTY, and where the system does not say.
    foreground-busy: func() -> bool;

    /// Stop it.
    kill: func();
  }
}

/// Name resolution for `wasi:sockets`. Linked, together with the TCP parts of
/// `wasi:sockets`, only when `plugin.json` lists `host:port` pairs in
/// `permissions.sockets` and the user approved them. `wasi:sockets/ip-name-lookup`
/// itself is never linked: it would resolve any name, and a lookup of a made-up
/// name is enough to leak data. So a plugin resolves through here, which answers
/// only for the approved pairs, and then connects by address; the host lets it
/// connect only to the addresses those names resolve to, on the approved ports.
/// UDP is not available.
interface sockets {
  /// The addresses (`"93.184.215.14"`, `"2606:2800::1"`) of an approved `host`
  /// for `port`.
  resolve: func(host: string, port: u16) -> result<list<string>, string>;
}

// ---------------------------------------------------------------------------
// Guest exports — what a provider implements
// ---------------------------------------------------------------------------

interface provider {
  use types.{
    ffon, list-item, search-result, frame, key, descriptor, poll-result,
    provider-op, palette, task-event,
  };

  // ---- Lifecycle ---------------------------------------------------------

  /// Called once before any other export.
  init: func();

  /// Constant properties. Called once, immediately after `init`, and cached by
  /// the host for the provider's lifetime.
  describe: func() -> descriptor;

  /// Called once before the provider is dropped.
  cleanup: func();

  // ---- Background tasks --------------------------------------------------

  /// Run one task, in a fresh worker instance (see `interface tasks`).
  run-task: func(name: string, input: list<u8>) -> result<list<u8>, string>;

  /// In the UI instance: progress from, or the end of, a task it spawned.
  on-task-event: func(id: u64, event: task-event);

  // ---- Data source -------------------------------------------------------

  /// Children at the current path. The one genuinely required export.
  fetch: func() -> ffon;

  /// Children for the current *sub*-path, so the host can refresh one Obj's
  /// children without rebuilding the provider root. Absent means "fall back to a
  /// full refresh".
  fetch-subtree-children: func() -> option<ffon>;

  /// The display key for the parent Obj while inside a subtree, so the host can
  /// update children and parent label in one pass. Queried straight after
  /// `fetch-subtree-children` returns something.
  fetch-subtree-parent-key: func() -> option<string>;

  /// Re-sync internal compose state from the FFON body children, after a
  /// host-level tree mutation (undo/redo of a delete) touched them.
  sync-ffon-body-children: func(children: ffon);

  // ---- Per-frame state ---------------------------------------------------

  /// Everything the host needs each frame, batched. See `poll-result`.
  poll: func() -> poll-result;

  // ---- Navigation --------------------------------------------------------
  //
  // The mutators return the resulting path so the host can cache it; that is why
  // there is no `current-path` export.

  push-path: func(segment: string) -> string;
  pop-path: func() -> string;
  set-current-path: func(path: string) -> string;

  // ---- Editing -----------------------------------------------------------

  commit-edit: func(old: string, new: string) -> bool;

  // ---- File operations ---------------------------------------------------

  create-directory: func(name: string) -> bool;
  create-file: func(name: string) -> bool;
  delete-item: func(name: string) -> bool;
  copy-item: func(src-dir: string, src-name: string, dest-dir: string, dest-name: string) -> bool;

  // ---- Commands ----------------------------------------------------------

  /// Stable command identifiers, matched on by `handle-command` and
  /// `execute-command`.
  commands: func() -> list<string>;

  /// Localized text for a command id.
  command-label: func(cmd: string) -> string;

  /// Begin a command. Returns an optional UI element for gathering input.
  /// Replaces the trait's `&mut String` error out-param.
  handle-command: func(cmd: string, elem-key: string, elem-type: s32) -> result<option<ffon>, string>;

  command-list-items: func(cmd: string) -> list<list-item>;
  execute-command: func(cmd: string, selection: string) -> bool;

  /// Build a new element for an "Add element:" section.
  create-element: func(key: string) -> option<ffon>;

  // ---- Interactive element callbacks -------------------------------------

  on-radio-change: func(group: string, value: string);
  on-button-press: func(function-name: string);
  on-checkbox-change: func(label: string, checked: bool);

  /// Prefill the provider's live `<input>` slot for the next `fetch`.
  set-input-value: func(value: string);

  /// One of this plugin's declared settings changed. The host drives this from the
  /// same `(key, value)` queue that feeds built-in providers.
  on-setting-change: func(key: string, value: string);

  // ---- Timeline undo/redo ------------------------------------------------

  /// Drain entries emitted since the last poll. The host calls this after every
  /// `handle-command` / `execute-command` / `commit-edit`.
  take-timeline-entries: func() -> list<provider-op>;

  /// Reverse a previously emitted entry.
  undo: func(entry: provider-op) -> result<_, string>;

  /// Re-apply a previously emitted entry.
  redo: func(entry: provider-op) -> result<_, string>;

  // ---- Extended search ---------------------------------------------------

  /// All searchable items for Ctrl+F. Absent falls back to FFON tree traversal.
  collect-extended-search-items: func() -> option<list<search-result>>;

  // ---- Persistent config -------------------------------------------------
  //
  // The host does the file I/O; a guest never sees a path or a descriptor.

  load-config: func(contents: list<u8>) -> bool;
  save-config: func() -> option<list<u8>>;

  // ---- Dashboard ---------------------------------------------------------

  /// Where to find a static fullscreen image, used when `dashboard-kind` is `image`.
  ///
  /// Two accepted forms:
  ///   - `asset:<plugin-name>/<file>` — a file under `assets/` in this plugin's own
  ///     install directory. Preferred: the host resolves it through the same
  ///     registry that serves a built-in provider's compiled-in assets, and the
  ///     same URI works inside an `<image>` tag.
  ///   - a plain relative path, resolved RELATIVE TO THIS PLUGIN'S OWN INSTALL
  ///     DIRECTORY. Kept working for plugins built against 0.3.x.
  ///
  /// Rejected: absolute paths, any `..` segment, and an `asset:` URI naming a
  /// *different* plugin. A sandboxed guest has no legitimate business naming a host
  /// path or another plugin's data.
  dashboard-image-path: func() -> option<string>;

  /// Render one frame of the interactive dashboard. Called every frame while this
  /// provider owns the dashboard, so it is the most performance-sensitive export
  /// in this file.
  dashboard-render: func(cols: u16, rows: u16) -> frame;

  /// A non-printable or modified key.
  ///
  /// The returned bool asks the host for a **redraw**. It does NOT mean "I consumed
  /// this key": while an interactive dashboard is open the host forwards every key
  /// here regardless, because a terminal emulator has to be able to receive Escape,
  /// Tab and Ctrl+letter. A plugin therefore cannot claim an exit key — leaving the
  /// dashboard is the host's double-Ctrl+C.
  dashboard-key: func(k: key) -> bool;

  /// Text the OS produced, with dead keys and IME already applied.
  dashboard-text: func(text: string);

  /// A clipboard paste. Distinct from `dashboard-text` so a terminal can wrap it
  /// in bracketed-paste markers when the child program enabled `?2004`.
  dashboard-paste: func(text: string);

  /// The cell viewport resized. Called once on entry and on every later change.
  dashboard-resize: func(rows: u16, cols: u16);

  /// Where the list cursor was when the dashboard was entered, as indices at
  /// each level below the provider's own top level. Called immediately before
  /// `enter-dashboard`.
  set-dashboard-entry: func(path: list<u32>);

  enter-dashboard: func();
  leave-dashboard: func();

  /// The host's active colours. Called before each `dashboard-render`.
  set-dashboard-palette: func(p: palette);
}

// ---------------------------------------------------------------------------
// World
// ---------------------------------------------------------------------------

/// What a sicompass plugin is: it may call `host` (always) and `net` (only if its
/// manifest declares `allowedHosts`), and it must provide `provider`. The WASI p2
/// interfaces its `std` needs are linked by the host as described at the top of
/// this file, not named here.
world plugin {
  import host;
  import net;
  import desktop;
  import license;
  import tasks;
  import process;
  import sockets;
  export provider;
}
